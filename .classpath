<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <classpathentry kind="src" path="src/main/java"/>
    <classpathentry kind="src" path="src/test/java" output="build/test-classes">
        <attributes>
            <attribute name="test" value="true"/>
        </attributes>
    </classpathentry>
    <classpathentry kind="lib" path="junit4/junit-4.13.2.jar"/>
    <classpathentry kind="lib" path="junit4/hamcrest-core-1.3.jar"/>
    <classpathentry kind="lib" path="junit4/mockito-all-1.9.5.jar"/>
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21"/>
    <classpathentry kind="output" path="build/classes"/>
</classpath>
